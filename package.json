{
  "name": "lyra",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "lint:structure": "tsx tools/verify-boundaries.ts",
    "lint:architecture-health": "tsx tools/verify-architecture-health.ts",
    "lint:agent-boundary": "tsx tools/verify-agent-boundary.ts",
    "lint:no-jcode-public-api": "tsx tools/verify-no-jcode-public-api.ts",
    "lint:native-core": "tsx tools/verify-native-core.ts",
    "lint:ui-style": "tsx tools/verify-workbench-style.ts",
    "lint:harmony-ui": "tsx tools/harmony/write-workbench-ui-contract.ts --check",
    "lint:prompt-contract": "tsx tools/verify-prompt-contract.ts",
    "lint:i18n": "pnpm --filter @lyra/desktop lint:i18n",
    "i18n:language-pack-manifest": "tsx tools/generate-language-pack-source-manifest.ts",
    "i18n:language-pack-manifest:check": "tsx tools/generate-language-pack-source-manifest.ts --check",
    "i18n:language-pack-release:check": "tsx tools/verify-official-language-pack-release.ts",
    "lint:agent-contract": "tsx tools/verify-agent-contract.ts",
    "lint:no-natural-language-semantics": "tsx tools/verify-no-natural-language-semantics.ts",
    "lint:repo-hygiene": "tsx tools/verify-repo-hygiene.ts",
    "lint:ts": "pnpm -r --filter \"./services/**\" --filter \"./packages/**\" run typecheck",
    "lint:desktop": "pnpm --filter @lyra/desktop typecheck",
    "lint:rust": "cargo clippy --workspace --all-targets --no-deps",
    "version:check": "tsx tools/verify-release-version.ts",
    "check": "pnpm lint:structure && pnpm lint:architecture-health && pnpm lint:agent-boundary && pnpm lint:no-jcode-public-api && pnpm lint:native-core && pnpm lint:ui-style && pnpm lint:harmony-ui && pnpm lint:prompt-contract && pnpm lint:i18n && pnpm i18n:language-pack-manifest:check && pnpm lint:agent-contract && pnpm lint:no-natural-language-semantics && pnpm lint:repo-hygiene && pnpm version:check && pnpm lint:ts && pnpm lint:desktop && pnpm core:payload:check && pnpm components:test && pnpm apps:test && pnpm documentation:check && pnpm web:check",
    "legal:generate": "tsx tools/generate-third-party-notices.ts",
    "legal:notices:check": "tsx tools/generate-third-party-notices.ts --check",
    "legal:copyleft:package": "tsx tools/licenses/create-copyleft-release.ts",
    "legal:publication-record": "tsx tools/legal/create-publication-record.ts",
    "legal:check": "pnpm --filter @lyra/site legal:check && pnpm legal:notices:check",
    "legal:release-check": "pnpm --filter @lyra/site legal:release-check && pnpm legal:notices:check",
    "docs:generate": "node docs/scripts/generate-inventories.mjs",
    "docs:internal:check": "node docs/scripts/check-docs.mjs",
    "docs:public:check": "pnpm --filter @lyra/docs-web check",
    "docs:contracts:production-check": "cargo test -p lyra-agent-runtime --test public_docs_contracts",
    "docs:check": "pnpm docs:public:check && pnpm docs:internal:check && pnpm docs:contracts:production-check",
    "documentation:check": "pnpm docs:check && pnpm legal:check",
    "web:check": "pnpm --filter @lyra/docs-web types:check && pnpm --filter @lyra/docs-web build && pnpm --filter @lyra/site test && pnpm --filter @lyra/site typecheck && pnpm --filter @lyra/site build",
    "components:package-release": "tsx tools/components/package-release.ts",
    "components:stage-desktop-release": "tsx tools/components/stage-desktop-release.ts",
    "components:generate-signing-key": "tsx tools/components/generate-signing-key.ts",
    "components:generate-release-key": "tsx tools/components/generate-release-key.ts",
    "components:sign-keyring": "tsx tools/components/sign-release-keyring.ts",
    "components:trust:check": "tsx tools/components/check-trusted-keys.ts",
    "components:test": "tsx --test tools/components/*.test.ts tools/installer/*.test.ts",
    "core:payload:inspect": "tsx tools/components/check-core-payload.ts",
    "core:payload:check": "pnpm --filter @lyra/desktop exec electron-vite build && pnpm core:payload:inspect",
    "installer:offline-bundle": "tsx tools/installer/create-offline-bundle.ts",
    "installer:package": "tsx tools/installer/package-installer.ts",
    "installer:package-linux": "tsx tools/installer/package-linux-formats.ts",
    "installer:aur-materials": "tsx tools/installer/generate-aur-materials.ts",
    "apps:build": "pnpm --filter \"@lyra/app-*\" --workspace-concurrency=3 run build",
    "apps:build:release": "pnpm --filter \"@lyra/app-*\" --workspace-concurrency=3 run build:release",
    "apps:release:check": "pnpm apps:build:release && tsx tools/apps/check-first-party-release.ts",
    "apps:test": "pnpm apps:build && tsx --test tools/apps/*.test.ts",
    "new:module": "tsx tools/new-module.ts",
    "lsp:bundle:rust-analyzer": "npm --prefix apps/desktop run lsp:bundle:rust-analyzer",
    "lsp:preflight": "npm --prefix apps/desktop run lsp:preflight",
    "build:ts": "pnpm -r --filter \"./apps/**\" --filter \"./services/**\" --filter \"./packages/**\" --filter \"./web/docs\" run build",
    "dev:desktop": "tsx scripts/dev/desktop-with-docs.ts",
    "dev:desktop:app": "pnpm --filter @lyra/desktop dev",
    "dev:docs": "pnpm --filter @lyra/docs-web dev",
    "build:docs": "pnpm --filter @lyra/docs-web build",
    "preview:docs": "pnpm --filter @lyra/docs-web preview",
    "dev:browser-automation": "pnpm --filter @lyra/browser-automation dev"
  },
  "devDependencies": {
    "@types/yauzl": "^2.10.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "yauzl": "^3.2.1"
  }
}
