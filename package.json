{
  "name": "lyra",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "lint:structure": "tsx tools/verify-boundaries.ts",
    "lint:architecture-health": "tsx tools/verify-architecture-health.ts",
    "lint:agent-boundary": "tsx tools/verify-agent-boundary.ts",
    "lint:no-jcode-public-api": "tsx tools/verify-no-jcode-public-api.ts",
    "lint:native-core": "tsx tools/verify-native-core.ts",
    "lint:ui-style": "tsx tools/verify-workbench-style.ts",
    "check": "pnpm lint:structure && pnpm lint:architecture-health && pnpm lint:agent-boundary && pnpm lint:no-jcode-public-api && pnpm lint:native-core && pnpm lint:ui-style",
    "new:module": "tsx tools/new-module.ts",
    "lsp:bundle:rust-analyzer": "npm --prefix apps/desktop run lsp:bundle:rust-analyzer",
    "lsp:preflight": "npm --prefix apps/desktop run lsp:preflight",
    "build:ts": "pnpm -r --filter './apps/**' --filter './services/**' --filter './packages/**' run build",
    "dev:desktop": "tsx scripts/dev/desktop-with-docs.ts",
    "dev:desktop:app": "pnpm --filter @lyra/desktop dev",
    "dev:docs": "npm --prefix web/docs run dev",
    "wasm:build:render": "tsx scripts/wasm/build-render-wasm.ts",
    "build:docs": "npm --prefix web/docs run build",
    "preview:docs": "npm --prefix web/docs run preview",
    "dev:site": "npm --prefix web/site run dev",
    "build:site": "npm --prefix web/site run build",
    "preview:site": "npm --prefix web/site run preview",
    "dev:control-plane": "pnpm --filter @lyra/control-plane dev",
    "dev:browser-automation": "pnpm --filter @lyra/browser-automation dev"
  },
  "devDependencies": {
    "@types/yauzl": "^2.10.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "yauzl": "^3.2.1"
  }
}
