{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LyraAppManifest",
  "type": "object",
  "required": [
    "id",
    "title",
    "version",
    "source",
    "permissions",
    "capabilities",
    "compatibility",
    "contributes"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "enum": ["builtin", "local-package"] },
    "entry": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "permissions": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+(?::[a-z0-9._-]+)*$" }
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9._-]+$" }
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "minApiVersion": { "type": "string" },
        "platforms": {
          "type": "array",
          "items": { "type": "string", "enum": ["macos", "windows", "linux"] }
        }
      },
      "additionalProperties": false
    },
    "contributes": {
      "type": "object",
      "required": ["surfaces"],
      "properties": {
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["workspace", "ai-computer", "settings", "background"] }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
