{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LyraCapabilityRegistrySnapshot",
  "type": "object",
  "required": ["updatedAt", "apps", "capabilities"],
  "properties": {
    "updatedAt": { "type": "string", "minLength": 1 },
    "apps": { "type": "array", "items": { "$ref": "./app-manifest.schema.json" } },
    "capabilities": { "type": "array", "items": { "$ref": "./capability.schema.json" } }
  },
  "additionalProperties": false
}
