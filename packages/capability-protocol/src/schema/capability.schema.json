{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LyraCapabilityDescriptor",
  "type": "object",
  "required": [
    "id",
    "domain",
    "kind",
    "title",
    "appId",
    "operation",
    "permissions",
    "risk",
    "approvalMode",
    "aiExposure",
    "inputSchema",
    "outputSchema"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9._-]+$" },
    "domain": { "type": "string", "enum": ["filesystem", "terminal", "browser", "mcp"] },
    "kind": { "type": "string", "enum": ["action", "resource", "event"] },
    "title": { "type": "string", "minLength": 1 },
    "appId": { "type": "string", "minLength": 1 },
    "operation": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "permissions": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+(?::[a-z0-9._-]+)*$" } },
    "risk": { "type": "string", "enum": ["read", "write", "command", "network"] },
    "approvalMode": { "type": "string", "enum": ["auto", "ask", "deny"] },
    "aiExposure": { "type": "string", "enum": ["hidden", "read", "full"] },
    "inputSchema": { "type": "object", "minProperties": 1 },
    "outputSchema": { "type": "object", "minProperties": 1 },
    "eventSchema": { "type": "object", "minProperties": 1 }
  },
  "additionalProperties": false
}
