{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lyra.ltd/contracts/v1/software-capability.schema.json",
  "title": "Lyra Software Capability manifest v1",
  "description": "Preview declaration of a software surface and its actions.",
  "x-lyra-contract": {
    "status": "preview",
    "version": "1",
    "applicableAppVersion": "0.1.x beta",
    "verifiedDate": "2026-07-28"
  },
  "$ref": "#/$defs/software",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,191}$"
    },
    "actionIdentifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,191}$"
    },
    "action": {
      "type": "object",
      "required": ["id", "title", "description", "risk"],
      "properties": {
        "id": { "$ref": "#/$defs/actionIdentifier" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "risk": {
          "enum": ["read", "navigate", "write", "external", "destructive"]
        },
        "inputSchema": {},
        "outputSchema": {}
      },
      "additionalProperties": false
    },
    "software": {
      "type": "object",
      "required": ["id", "title", "description", "actions"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/action" }
        }
      },
      "additionalProperties": false
    }
  }
}
