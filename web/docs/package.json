{
  "name": "@lyra/docs-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 5174",
    "build": "next build",
    "start": "wrangler dev --port 5174",
    "preview": "pnpm build && wrangler dev --port 5174",
    "cf:build": "pnpm build",
    "cf:preview": "pnpm cf:build && wrangler dev",
    "cf:deploy": "pnpm cf:build && wrangler deploy",
    "cf:deploy:built": "wrangler deploy",
    "cf:check": "pnpm cf:build && wrangler deploy --dry-run",
    "docs:check": "node scripts/check-docs.mjs",
    "contracts:check": "node scripts/check-contracts.mjs && node --import ./scripts/mock-electron.mjs --import tsx ./scripts/check-production-contracts.mjs",
    "mcp:smoke": "node scripts/mcp-smoke.mjs",
    "check": "pnpm docs:check && pnpm contracts:check && pnpm mcp:smoke && pnpm types:check",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@lyra/markdown-render": "file:../../packages/markdown-render",
    "@orama/orama": "3.1.18",
    "@orama/tokenizers": "3.1.18",
    "fumadocs-core": "16.7.7",
    "fumadocs-mdx": "14.2.12",
    "fumadocs-ui": "16.7.7",
    "katex": "^0.16.45",
    "lucide-react": "^0.469.0",
    "mermaid": "^11.15.0",
    "next": "16.2.12",
    "next-themes": "0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.18",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "wrangler": "4.114.0"
  }
}
