{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "../..",
    "outDir": "dist/types",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "electron", "vite/client", "vitest/globals", "@webgpu/types"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@lyra/browser-automation": ["../../services/browser-automation/src/index.ts"],
      "@lyra/app-runtime": ["../../packages/app-runtime/src/index.ts"],
      "@genoffice/docx-engine": ["src/main/office/genoffice-docx.d.ts"],
      "@genoffice/docx-headless": ["src/main/office/genoffice-docx-headless.d.ts"],
      "@genoffice/docx-engine/text-patch": ["src/main/office/genoffice-docx.d.ts"],
      "@genoffice/pptx-engine": ["src/main/office/genoffice-pptx.d.ts"],
      "@genoffice/pptx-ops": ["src/main/office/genoffice-pptx.d.ts"],
      "@genoffice/pptx-render": ["src/main/office/genoffice-pptx-render.d.ts"],
      "@genoffice/xlsx-dsl": ["src/main/office/genoffice-xlsx-dsl.d.ts"],
      "@genoffice/xlsx-gateway/gateway/xlsx-gateway": ["src/main/office/genoffice-xlsx.d.ts"],
      "@genoffice/xlsx-gateway/gateway/csv-import": ["src/main/office/genoffice-xlsx.d.ts"],
      "@genoffice/pipelines": ["src/main/office/genoffice-pipelines.d.ts"],
      "@genoffice/pdf2docx": ["src/main/office/genoffice-pdf2docx.d.ts"],
      "@genoffice/xlsx-gateway/domain/cell-address": ["src/main/office/genoffice-xlsx.d.ts"],
      "@lyra/icons": ["../../packages/icons/src/index.ts"],
      "@lyra/icons/file-type": ["../../packages/icons/src/file-type.tsx"],
      "@lyra/icons/brands": ["../../packages/icons/src/brands.ts"],
      "@react-three/fiber": ["src/types/react-three-fiber.ts"],
      "@renderer/*": ["src/renderer/*"],
      "@workbench/*": ["src/modules/workbench/*"],
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "electron.vite.config.ts",
    "vitest.config.ts"
  ]
}
