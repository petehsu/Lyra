{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "../..",
    "outDir": "dist/types",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "electron", "vite/client", "vitest/globals", "@webgpu/types"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@lyra/browser-automation": ["../../services/browser-automation/src/index.ts"],
      "@lyra/markdown-render": ["../../packages/markdown-render/src/index.ts"],
      "@lyra/app-runtime": ["../../packages/app-runtime/src/index.ts"],
      "@react-three/fiber": ["src/types/react-three-fiber.ts"],
      "@renderer/*": ["src/renderer/*"],
      "@workbench/*": ["src/modules/workbench/*"],
      "lucide-react": ["src/types/lucide-react.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "electron.vite.config.ts",
    "vitest.config.ts"
  ]
}
