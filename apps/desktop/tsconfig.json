{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "../..",
    "outDir": "dist/types",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "electron", "vite/client", "vitest/globals"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@lyra/capability-protocol": ["../../packages/capability-protocol/src/index.ts"],
      "@lyra/plugin-sdk": ["../../packages/plugin-sdk/src/index.ts"],
      "@renderer/*": ["src/renderer/*"],
      "@workbench/*": ["src/modules/workbench/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "electron.vite.config.ts",
    "vitest.config.ts"
  ]
}
