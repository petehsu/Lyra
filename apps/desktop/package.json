{
  "name": "@lyra/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "native:build": "cargo build --manifest-path ../../Cargo.toml -p lyrad && cargo build --manifest-path ../../Cargo.toml -p lyra-cli && cargo build --manifest-path ../../Cargo.toml -p lyra-performance-core && cargo build --manifest-path ../../Cargo.toml -p lyra-terminal-core -F lyra-terminal-core/node-api -p lyra-lsp-core -F lyra-lsp-core/node-api -p lyra-files-napi -p lyra-image-napi -p lyra-docs-napi -p lyra-render-napi -p lyra-download-core -p lyra-download-napi -p lyra-accessibility-napi && npm run native:stage",
    "native:build:release": "node --import tsx ../../scripts/desktop/stage-native-resources.ts --release --clean",
    "native:stage": "node --import tsx ../../scripts/desktop/stage-native-resources.ts --stage-only",
    "electron:ensure": "node --import tsx ../../scripts/desktop/ensure-electron.ts",
    "lyra-design:bundle-playwright": "node --import tsx ../../scripts/desktop/install-lyra-design-playwright.ts",
    "downloads:build-aria2-bundles": "node --import tsx ../../tools/download-manager/build-aria2-bundles.ts",
    "downloads:verify-aria2-bundles": "node --import tsx ../../tools/download-manager/verify-aria2-bundles.ts",
    "lsp:bundle:rust-analyzer": "node --import tsx ../../tools/lsp/install-rust-analyzer.ts",
    "lsp:preflight": "node --import tsx ../../tools/lsp/preflight-lsp.ts",
    "release:preflight": "npm run typecheck && npm run test && npm run downloads:verify-aria2-bundles -- --all-targets && node --import tsx ../../tools/lsp/preflight-lsp.ts --all-targets",
    "dev:electron-vite": "npm run electron:ensure && npm run dev:electron-vite:raw",
    "dev:electron-vite:raw": "node --import tsx ../../scripts/desktop/dev-electron-vite.ts",
    "dev": "npm run native:build && npm run dev:electron-vite",
    "dev:fast": "npm run dev:electron-vite",
    "build": "npm run lyra-design:bundle-playwright && npm run native:build && electron-vite build",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb rpm tar.gz",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:ui-style": "node --import tsx ../../tools/verify-workbench-style.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "icon:app": "node --import tsx ../../scripts/desktop/generate-app-icons.ts",
    "icon:mac": "npm run icon:app"
  },
  "build": {
    "appId": "dev.lyra.desktop",
    "productName": "Lyra",
    "executableName": "Lyra",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icons/macos/lyra.icns",
      "extendInfo": {
        "NSLocationWhenInUseUsageDescription": "Lyra uses your physical location to show where you are in the AI panel. Location is not sent to the Agent."
      }
    },
    "win": {
      "icon": "resources/icons/win/lyra.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "tar.gz"
      ],
      "category": "Development",
      "icon": "resources/icons/linux"
    },
    "afterPack": "../../scripts/desktop/after-pack-linux.cjs",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "extraResources": [
      {
        "from": "resources/icons/app",
        "to": "icons/app",
        "filter": [
          "*.png"
        ]
      },
      {
        "from": "native",
        "to": "native",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/aria2",
        "to": "aria2",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/download-manager",
        "to": "download-manager",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "resources/playwright-browsers",
        "to": "playwright-browsers",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/lsp",
        "to": "lsp",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/main/location/read-macos-location.swift",
        "to": "location/read-macos-location.swift"
      }
    ]
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.2.10",
    "@fontsource/geist-mono": "^5.2.8",
    "@fontsource/geist-sans": "^5.2.5",
    "@lobehub/icons": "1.80.0",
    "@novnc/novnc": "^1.7.0",
    "@radix-ui/react-checkbox": "^1.3.4",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-toast": "^1.2.16",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@react-three/fiber": "^8.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "darkreader": "^4.9.120",
    "dompurify": "^3.3.3",
    "katex": "^0.16.45",
    "lucide-react": "^0.469.0",
    "monaco-editor": "^0.52.2",
    "pinyin-pro": "^3.27.0",
    "playwright": "1.60.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "vscode-jsonrpc": "8.2.0",
    "ws": "^8.20.0",
    "xterm": "^5.3.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/dagre": "^0.7.54",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.184.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "electron": "41.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "jsdom": "^25.0.1",
    "pyright": "^1.1.408",
    "sass-embedded": "^1.100.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "typescript-language-server": "^5.1.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  }
}
