{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "LocalSearchIndexState": {
      "enum": [
        "empty",
        "indexing",
        "ready",
        "partial",
        "failed",
        "walker"
      ],
      "type": "string"
    },
    "LocalSearchRootStatus": {
      "properties": {
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "indexedContentFileCount": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "indexedDirCount": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "indexedFileCount": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "lastIndexedAt": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "root": {
          "type": "string"
        },
        "state": {
          "$ref": "#/definitions/LocalSearchIndexState"
        }
      },
      "required": [
        "indexedContentFileCount",
        "indexedDirCount",
        "indexedFileCount",
        "root",
        "state"
      ],
      "type": "object"
    },
    "LocalSearchStatus": {
      "properties": {
        "indexedContentFileCount": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "indexedDirCount": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "indexedFileCount": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "roots": {
          "items": {
            "$ref": "#/definitions/LocalSearchRootStatus"
          },
          "type": "array"
        },
        "sqliteFtsAvailable": {
          "type": "boolean"
        },
        "state": {
          "$ref": "#/definitions/LocalSearchIndexState"
        }
      },
      "required": [
        "indexedContentFileCount",
        "indexedDirCount",
        "indexedFileCount",
        "roots",
        "sqliteFtsAvailable",
        "state"
      ],
      "type": "object"
    }
  },
  "properties": {
    "status": {
      "$ref": "#/definitions/LocalSearchStatus"
    }
  },
  "required": [
    "status"
  ],
  "title": "LocalSearchIndexRootResponse",
  "type": "object"
}