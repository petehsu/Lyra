    },
    "threadId": {
      "type": "string"
    },
    "viewModel": {
      "anyOf": [
        {
          "$ref": "#/definitions/ThreadReadViewModelParams"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional view model projection to build alongside the thread metadata."
