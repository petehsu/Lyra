        {
          "properties": {
            "kind": {
              "enum": [
                "aiPanel"
              ],
              "type": "string"
            },
            "runtimeFeedLimit": {
              "format": "uint32",
              "minimum": 0.0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "title": "KindThreadReadViewModelParams",
          "type": "object"
        }
      ]
