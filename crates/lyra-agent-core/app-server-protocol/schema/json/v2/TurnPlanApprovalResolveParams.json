{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "PlanAnnotation": {
      "properties": {
        "anchor": {
          "type": "string"
        },
        "blockId": {
          "type": [
            "string",
            "null"
          ]
        },
        "comment": {
          "type": "string"
        }
      },
      "required": [
        "anchor",
        "comment"
      ],
      "type": "object"
    },
    "PlanApprovalDecision": {
      "enum": [
        "approve_and_implement",
        "keep_planning",
        "reject"
      ],
      "type": "string"
    },
    "PlanArtifact": {
      "properties": {
        "acceptanceCriteria": {
          "default": [],
          "items": {
            "$ref": "#/definitions/PlanArtifactBlock"
          },
          "type": "array"
        },
        "assumptions": {
          "default": [],
          "items": {
            "$ref": "#/definitions/PlanArtifactBlock"
          },
          "type": "array"
        },
        "interfaces": {
          "default": [],
          "items": {
            "$ref": "#/definitions/PlanArtifactBlock"
          },
          "type": "array"
        },
        "objective": {
          "type": "string"
        },
        "planId": {
          "type": "string"
        },
        "risks": {
          "default": [],
          "items": {
            "$ref": "#/definitions/PlanArtifactBlock"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/definitions/PlanArtifactStatus"
        },
        "steps": {
          "default": [],
          "items": {
            "$ref": "#/definitions/PlanArtifactBlock"
          },
          "type": "array"
        },
        "summary": {
          "type": "string"
        },
        "tests": {
          "default": [],
          "items": {
            "$ref": "#/definitions/PlanArtifactBlock"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "objective",
        "planId",
        "status",
        "summary",
        "title"
      ],
      "type": "object"
    },
    "PlanArtifactBlock": {
      "properties": {
        "body": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "body",
        "id",
        "kind",
        "title"
      ],
      "type": "object"
    },
    "PlanArtifactStatus": {
      "enum": [
        "draft",
        "proposed",
        "approved",
        "rejected"
      ],
      "type": "string"
    }
  },
  "properties": {
    "annotations": {
      "default": [],
      "items": {
        "$ref": "#/definitions/PlanAnnotation"
      },
      "type": "array"
    },
    "artifactSnapshot": {
      "anyOf": [
        {
          "$ref": "#/definitions/PlanArtifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "decision": {
      "$ref": "#/definitions/PlanApprovalDecision"
    },
    "feedback": {
      "type": [
        "string",
        "null"
      ]
    },
    "planId": {
      "type": "string"
    },
    "planTurnId": {
      "type": "string"
    },
    "threadId": {
      "type": "string"
    }
  },
  "required": [
    "decision",
    "planId",
    "planTurnId",
    "threadId"
  ],
  "title": "TurnPlanApprovalResolveParams",
  "type": "object"
}