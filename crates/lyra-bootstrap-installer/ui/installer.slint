import "./fonts/ZenDots-Regular.ttf";
import { Palette } from "std-widgets.slint";

export struct StatusGlyph {
    glyph: string,
    offset-y: float,
    opacity: float,
}

component FolderMark inherits Rectangle {
    in property <brush> ink;
    width: 16px;
    height: 14px;
    background: transparent;

    Rectangle {
        x: 0px;
        y: 4px;
        width: 16px;
        height: 10px;
        border-radius: 2px;
        background: root.ink;
        opacity: 0.88;
    }
    Rectangle {
        x: 0px;
        y: 1px;
        width: 7px;
        height: 5px;
        border-radius: 1.5px;
        background: root.ink;
        opacity: 0.88;
    }
}

component ActionButton inherits Rectangle {
    in-out property <string> caption;
    in property <bool> dark-mode;
    in property <bool> primary: true;
    callback clicked();

    width: 116px;
    height: 34px;
    border-radius: 8px;
    background: root.primary
        ? (root.dark-mode ? #f6f5f6 : #191919)
        : (root.dark-mode ? #2a2a2a : #e7e6e7);
    border-width: root.primary ? 0px : 1px;
    border-color: root.dark-mode ? #3a3a3a : #d8d7d8;

    Text {
        width: 100%;
        height: 100%;
        text: root.caption;
        color: root.primary
            ? (root.dark-mode ? #191919 : #f6f5f6)
            : (root.dark-mode ? #f6f5f6 : #191919);
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component InstallerWindow inherits Window {
    title: "Lyra Installer";
    width: 500px;
    height: 640px;
    background: root.dark-mode ? #191919 : #f6f5f6;

    private property <bool> dark-mode: Palette.color-scheme == ColorScheme.dark;
    private property <brush> primary-text: root.dark-mode ? #f2f2f2 : #1c1c1c;
    private property <brush> secondary-text: root.dark-mode ? #b3b3b3 : #6a6a6a;
    private property <brush> tertiary-text: root.dark-mode ? #8a8a8a : #8b8b8b;
    private property <brush> track: root.dark-mode ? #2d2d2d : #e4e3e4;
    private property <brush> fill: root.dark-mode ? #ffffff : #111111;

    in-out property <string> install-path: "";
    in property <string> install-path-label: "";
    in property <string> ascii-logo: "";
    in property <image> hero-frame;
    in property <bool> hero-has-video: false;
    in property <float> logo-wave: 0;
    in property <[StatusGlyph]> status-glyphs: [];
    in property <float> progress-value: 0;
    in property <bool> progress-indeterminate: false;
    in property <float> indeterminate-phase: 0;
    in property <string> rate-text: "";
    in property <string> percent-text: "";
    in-out property <bool> running: false;
    in-out property <bool> finished: false;
    in-out property <bool> failed: false;

    callback start-requested(string);
    callback browse-requested();
    callback retry-requested();
    callback close-requested();

    VerticalLayout {
        padding-top: 36px;
        padding-bottom: 28px;
        padding-left: 40px;
        padding-right: 40px;
        spacing: 0px;

        Rectangle {
            horizontal-stretch: 1;
            height: 236px;
            border-radius: 4px;
            clip: true;
            background: transparent;

            if root.hero-has-video: Image {
                x: (parent.width - 420px) / 2;
                y: 0px;
                width: 420px;
                height: 236px;
                source: root.hero-frame;
                image-fit: cover;
            }

            if !root.hero-has-video: VerticalLayout {
                alignment: center;
                spacing: 10px;
                width: 100%;
                height: 100%;

                Rectangle {
                    height: 168px;
                    clip: true;
                    Text {
                        width: 100%;
                        height: 100%;
                        text: root.ascii-logo;
                        color: root.primary-text;
                        font-family: "Menlo";
                        font-size: 4px;
                        font-weight: 400;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: no-wrap;
                    }
                    Rectangle {
                        x: parent.width * root.logo-wave - 70px;
                        y: 0px;
                        width: 110px;
                        height: 100%;
                        background: @linear-gradient(90deg, transparent 0%, root.primary-text 50%, transparent 100%);
                        opacity: 0.16;
                    }
                }

                Text {
                    text: "LYRA";
                    font-family: "Zen Dots";
                    font-size: 22px;
                    color: root.primary-text;
                    horizontal-alignment: center;
                }
            }
        }

        Rectangle { height: 22px; }

        Rectangle {
            height: 22px;
            clip: true;
            HorizontalLayout {
                alignment: center;
                spacing: 0px;
                for glyph in root.status-glyphs: Text {
                    text: glyph.glyph;
                    color: root.primary-text;
                    font-size: 13px;
                    opacity: glyph.opacity;
                    y: glyph.offset-y * 1px;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle { height: 16px; }

        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 380px;
                height: 3px;
                border-radius: 2px;
                background: root.track;
                clip: true;

                if !root.progress-indeterminate: Rectangle {
                    width: parent.width * max(0.0, min(1.0, root.progress-value));
                    height: 100%;
                    background: root.fill;
                }
                if root.progress-indeterminate: Rectangle {
                    x: (parent.width - 72px) * root.indeterminate-phase;
                    width: 72px;
                    height: 100%;
                    background: root.fill;
                }
            }
        }

        Rectangle { height: 8px; }

        HorizontalLayout {
            alignment: center;
            width: 380px;
            Text {
                text: root.rate-text;
                color: root.tertiary-text;
                font-size: 11px;
                horizontal-stretch: 1;
            }
            Text {
                text: root.percent-text;
                color: root.tertiary-text;
                font-size: 11px;
            }
        }

        Rectangle { height: 18px; }

        TouchArea {
            mouse-cursor: pointer;
            enabled: !root.running;
            clicked => {
                root.browse-requested();
            }
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                FolderMark {
                    ink: root.secondary-text;
                }
                Text {
                    text: root.install-path-label;
                    color: root.secondary-text;
                    font-size: 12px;
                    overflow: elide;
                    vertical-alignment: center;
                    width: 340px;
                }
            }
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            alignment: center;
            spacing: 10px;

            if root.failed: ActionButton {
                caption: "Close";
                dark-mode: root.dark-mode;
                primary: false;
                clicked => {
                    root.close-requested();
                }
            }
            if root.failed: ActionButton {
                caption: "Retry";
                dark-mode: root.dark-mode;
                clicked => {
                    root.retry-requested();
                }
            }
            if !root.failed && root.finished: ActionButton {
                caption: "Close";
                dark-mode: root.dark-mode;
                clicked => {
                    root.close-requested();
                }
            }
            if !root.failed && !root.finished && !root.running: ActionButton {
                caption: "Install";
                dark-mode: root.dark-mode;
                clicked => {
                    root.start-requested(root.install-path);
                }
            }
        }
    }
}
