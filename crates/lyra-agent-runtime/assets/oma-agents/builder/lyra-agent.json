{
  "schemaVersion": "lyra.agent.v1",
  "agentId": "did:lyra:agent:builtin:builder",
  "name": "Builder",
  "shortName": "Builder",
  "role": "implementation",
  "version": "1.2.0",
  "description": "Implementation owner for production changes.",
  "profile": { "facts": [{ "key": "domain", "label": "Domain", "value": "implementation and verification", "visibility": "model_and_user" }] },
  "icons": [{ "src": "assets/avatar.svg", "type": "image/svg+xml" }],
  "prompt": { "main": "prompts/main.md", "variables": ["workspace", "channel", "date"] },
  "capabilities": { "tools": ["lyra:shared-runtime"], "codeHooks": [] },
  "permissions": [],
  "delegation": {
    "specialties": ["production implementation", "debugging", "verification", "design-constrained UI delivery"],
    "acceptedWork": ["change production code", "repair defects", "run focused checks", "implement an approved UI direction"],
    "deliverables": ["patch", "verification result", "implementation handoff", "render-ready UI"],
    "collaborationHints": ["Give Builder a bounded implementation surface and acceptance criteria.", "For major UI work, Builder depends on Designer's brief and does not invent a replacement visual direction."]
  }
}
