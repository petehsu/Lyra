{
  "cases": [
    {
      "name": "atx_heading_h1",
      "markdown": "# Heading one",
      "expect": {
        "blocks": [
          { "kind": "heading", "level": 1, "text": "Heading one" }
        ]
      }
    },
    {
      "name": "paragraph",
      "markdown": "A plain paragraph.",
      "expect": {
        "blocks": [
          { "kind": "paragraph", "text": "A plain paragraph." }
        ]
      }
    },
    {
      "name": "link",
      "markdown": "[Example](https://example.com)",
      "expect": {
        "blocks": [
          { "kind": "link", "href": "https://example.com", "text": "Example" }
        ]
      }
    },
    {
      "name": "fenced_code_rust",
      "markdown": "```rust\nlet x = 1;\n```",
      "expect": {
        "blocks": [
          { "kind": "codeBlock", "language": "rust", "source": "let x = 1;\n" }
        ]
      }
    },
    {
      "name": "unordered_list",
      "markdown": "- one\n- two",
      "expect": {
        "blocks": [
          { "kind": "list", "ordered": false, "itemCount": 2 }
        ]
      }
    },
    {
      "name": "ordered_list",
      "markdown": "1. one\n2. two",
      "expect": {
        "blocks": [
          { "kind": "list", "ordered": true, "itemCount": 2 }
        ]
      }
    },
    {
      "name": "thematic_break",
      "markdown": "---",
      "expect": {
        "blocks": [
          { "kind": "thematicBreak" }
        ]
      }
    },
    {
      "name": "emphasis_strong",
      "markdown": "*emphasis* and **strong**",
      "expect": {
        "blocks": [
          { "kind": "paragraph", "text": "emphasis and strong" }
        ]
      }
    },
    {
      "name": "inline_code",
      "markdown": "Use `code` here.",
      "expect": {
        "blocks": [
          { "kind": "paragraph", "text": "Use code here." }
        ]
      }
    },
    {
      "name": "blockquote",
      "markdown": "> quoted text",
      "expect": {
        "blocks": [
          { "kind": "blockquote", "text": "quoted text" }
        ]
      }
    },
    {
      "name": "table_shape",
      "markdown": "| A | B |\n|---|---|\n| 1 | 2 |",
      "expect": {
        "blocks": [
          { "kind": "table", "columnCount": 2, "rowCount": 1 }
        ]
      }
    },
    {
      "name": "image_alt",
      "markdown": "![Alt text](https://example.com/logo.png)",
      "expect": {
        "blocks": [
          { "kind": "image", "src": "https://example.com/logo.png", "alt": "Alt text" }
        ]
      }
    },
    {
      "name": "setext_heading",
      "markdown": "Title\n---",
      "expect": {
        "blocks": [
          { "kind": "heading", "level": 2, "text": "Title" }
        ]
      }
    },
    {
      "name": "reference_style_link",
      "markdown": "[link]: https://example.com\n\n[link]",
      "expect": {
        "blocks": [
          { "kind": "link", "href": "https://example.com", "text": "link" }
        ]
      }
    },
    {
      "name": "strikethrough",
      "markdown": "~~deleted~~",
      "expect": {
        "blocks": [
          { "kind": "paragraph", "text": "deleted" }
        ]
      }
    },
    {
      "name": "task_list",
      "markdown": "- [x] done\n- [ ] todo",
      "expect": {
        "blocks": [
          { "kind": "list", "ordered": false, "itemCount": 2, "checkedStates": [true, false] }
        ]
      }
    }
  ]
}